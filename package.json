{
  "name": "ui-release-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Skills-based pre-release UI testing with Playwright MCP and generated Playwright specs",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile",
    "report": "playwright show-report",
    "setup": "playwright install --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0"
  }
}
