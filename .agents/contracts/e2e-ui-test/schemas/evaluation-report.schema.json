{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E2E coverage evaluation report v1",
  "description": "Written only by e2e-ui-test-coverage-evaluator.4 and 9.",
  "type": "object",
  "required": ["schemaVersion", "contractsVersion", "stage", "evaluatedCommit", "inputs", "gates", "scores", "findings", "counts",
    "executionStatus", "verdict", "verdictReason"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contractsVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "stage": { "enum": ["plan", "tests"] },
    "evaluatedCommit": { "$ref": "#/$defs/text" },
    "inputs": {
      "type": "object",
      "properties": {
        "manifest": { "$ref": "#/$defs/fileRef" },
        "inventory": { "$ref": "#/$defs/fileRef" },
        "setupDecisions": { "$ref": "#/$defs/fileRef" },
        "catalog": { "$ref": "#/$defs/fileRef" }
      }
    },
    "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
    "scores": {
      "type": "object",
      "properties": {
        "obligation_accounting": { "$ref": "#/$defs/unit" },
        "requirement_traceability": { "$ref": "#/$defs/unit" },
        "journey_proportionality": { "$ref": "#/$defs/unit" },
        "assertion_support": { "$ref": "#/$defs/likert" },
        "evidence_layer_honesty": { "$ref": "#/$defs/likert" },
        "scenario_class_coverage": { "$ref": "#/$defs/likert" },
        "selector_and_wait_quality": { "$ref": "#/$defs/likert" }
      }
    },
    "judge": {
      "type": "object",
      "required": ["model", "samples", "disagreements"],
      "properties": {
        "model": { "$ref": "#/$defs/text" },
        "dispatch": { "enum": ["batched", "per-sample", "unrecorded"] },
        "samples": { "type": "integer", "minimum": 1 },
        "disagreements": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "counts": {
      "type": "object",
      "properties": {
        "stories": { "$ref": "#/$defs/count" }, "criteria": { "$ref": "#/$defs/count" }, "obligations": { "$ref": "#/$defs/count" },
        "browserReviewed": { "$ref": "#/$defs/count" }, "blockedBrowser": { "$ref": "#/$defs/count" },
        "plannedBrowser": { "$ref": "#/$defs/count" }, "plannedObligations": { "$ref": "#/$defs/count" },
        "sourceIdentifiers": { "$ref": "#/$defs/count" }, "tracedIdentifiers": { "$ref": "#/$defs/count" },
        "unsupportedClaims": { "$ref": "#/$defs/count" }, "unaccountedObligations": { "$ref": "#/$defs/count" }
      }
    },
    "executionStatus": { "enum": ["NotRun", "Passed", "Failed", "Skipped"] },
    "verdict": { "enum": ["PASS", "REVIEW", "FAIL"] },
    "verdictReason": { "$ref": "#/$defs/text" }
  },
  "allOf": [
    {
      "if": { "properties": { "gates": { "contains": { "type": "object", "required": ["blocking", "result"], "properties": { "blocking": { "const": true }, "result": { "const": "fail" } } } } } },
      "then": { "properties": { "verdict": { "const": "FAIL" } } }
    },
    {
      "if": { "properties": { "findings": { "contains": { "type": "object", "required": ["severity"], "properties": { "severity": { "const": "high" } } } } } },
      "then": { "properties": { "verdict": { "const": "FAIL" } } }
    },
    {
      "if": { "properties": { "judge": { "type": "object", "required": ["disagreements"], "properties": { "disagreements": { "minimum": 1 } } } }, "required": ["judge"] },
      "then": { "properties": { "verdict": { "enum": ["REVIEW", "FAIL"] } } }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "unit": { "type": "number", "minimum": 0 },
    "likert": { "type": "number", "minimum": 1 },
    "fileRef": {
      "type": "object",
      "required": ["path", "fingerprint"],
      "properties": { "path": { "$ref": "#/$defs/text" }, "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "gate": {
      "type": "object",
      "required": ["gateId", "name", "result", "blocking", "evidence"],
      "properties": {
        "gateId": { "type": "string", "pattern": "^G-D\\d{2}$" },
        "name": { "$ref": "#/$defs/text" },
        "result": { "enum": ["pass", "fail", "not-implemented"] },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      },
      "if": { "properties": { "result": { "const": "not-implemented" } } },
      "then": { "properties": { "blocking": { "const": false } } }
    },
    "finding": {
      "type": "object",
      "required": ["findingId", "severity", "type", "routeTo", "description", "suggestion"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^EV-\\d{4}$" },
        "severity": { "enum": ["high", "medium", "low"] },
        "type": { "$ref": "#/$defs/text" },
        "obligationId": { "$ref": "#/$defs/text" },
        "testId": { "$ref": "#/$defs/text" },
        "routeTo": { "enum": ["e2e-ui-test-env-setup", "e2e-ui-test-plan-generator", "e2e-ui-test-generator", "e2e-ui-test-verify-run", "human"] },
        "description": { "$ref": "#/$defs/text" },
        "suggestion": { "$ref": "#/$defs/text" }
      }
    }
  }
}
